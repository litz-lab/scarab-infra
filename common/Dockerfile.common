# Install required packages
RUN apt update && DEBIAN_FRONTEND=noninteractive apt install -y \
    python3 \
    python3-pip \
    python2 \
    git \
    sudo \
    wget \
    cmake \
    binutils \
    libunwind-dev \
    libboost-dev \
    zlib1g-dev \
    libsnappy-dev \
    liblz4-dev \
    doxygen \
    libconfig++-dev \
    libboost-dev \
    vim \
    bc \
    unzip \
    zip \
    gosu \
    linux-tools-generic \
    gdb \
    graphviz \
    curl \
    time \
    clang-tidy-18 \
 && update-alternatives --install /usr/bin/clang-tidy clang-tidy \
      /usr/bin/clang-tidy-18 100

# Restore libpthread.so linker script on distros that omit it: Ubuntu jammy's
# libc6-dev no longer ships /usr/lib/x86_64-linux-gnu/libpthread.so because
# glibc 2.34+ merged libpthread into libc, but DynamoRIO's CMake bakes
# find_library(pthread) absolute paths into make targets that later break
# scarab build. Only create the stub when the file is missing; on older
# distros (e.g. Ubuntu 20.04) libpthread.so is a symlink to the runtime
# library that must not be overwritten.
RUN if [ ! -e /usr/lib/x86_64-linux-gnu/libpthread.so ]; then \
        echo 'GROUP ( /lib/x86_64-linux-gnu/libpthread.so.0 )' > /usr/lib/x86_64-linux-gnu/libpthread.so; \
    fi

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
RUN apt install -y nodejs
RUN npm install -g @anthropic-ai/claude-code

# The scarab-infra workflow scripts are deliberately NOT copied into the image.
# They are bind-mounted read-only from the host checkout onto $INFRA_HOME at
# `docker run` time and published into /usr/local/bin by root_entrypoint.sh.
# Baking them in used to invalidate this layer -- and therefore the DynamoRIO,
# pin and SimPoint builds below it -- on every edit, forcing a full --no-cache
# rebuild of a multi-GB image for a one-line shell change. The image now only
# owns the toolchain and the workload sources.
ENV INFRA_HOME="/scarab_infra"
RUN mkdir -p $INFRA_HOME

RUN mkdir -p /simpoint_traces
ENV trace_home="/simpoint_traces"

# Set the working directory
ENV tmpdir="/tmp_home"
RUN mkdir -p $tmpdir && chmod -R 755 $tmpdir
WORKDIR $tmpdir

# DynamoRIO package
# We will switch back to the official DynamoRIO once the fetched instruction counting logic is resolved (https://github.com/DynamoRIO/dynamorio/issues/4948)
# RUN cd $tmpdir && wget https://github.com/DynamoRIO/dynamorio/releases/download/release_10.0.0/DynamoRIO-Linux-10.0.0.tar.gz && tar -xzvf DynamoRIO-Linux-10.0.0.tar.gz
RUN cd $tmpdir && \
    git clone --branch release_10.0.0 --depth 1 https://github.com/5surim/dynamorio.git DynamoRIO-Linux-10.0.0 && \
    cd DynamoRIO-Linux-10.0.0 && \
    git submodule update --init --recursive && \
    cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo \
          -DBUILD_DOCS=OFF \
          -DGENERATE_DOCS=OFF \
          -DDOXYGEN=OFF \
          . && \
    make -j$(nproc) all && \
    make install && \
    mkdir -p tools/bin64 && cp -r clients/bin64/* tools/bin64/
ENV DYNAMORIO_HOME=$tmpdir/DynamoRIO-Linux-10.0.0/exports
RUN chmod 777 $DYNAMORIO_HOME/lib64/release/libdynamorio.so


# Build fingerprint client
COPY fingerprint_src $tmpdir/fingerprint_src/
RUN mkdir $tmpdir/fingerprint_src/build && \
    cd $tmpdir/fingerprint_src/build && \
    cmake -DDynamoRIO_DIR=$DYNAMORIO_HOME/cmake .. && \
    make && \
    cp ./libfpg.so $tmpdir/libfpg.so

# Install Scarab dependencies
RUN cd $tmpdir && wget -nc https://software.intel.com/sites/landingpage/pintool/downloads/pin-3.15-98253-gb56e429b1-gcc-linux.tar.gz && tar -xzvf pin-3.15-98253-gb56e429b1-gcc-linux.tar.gz

# Env to build Scarab
ENV PIN_ROOT $tmpdir/pin-3.15-98253-gb56e429b1-gcc-linux
ENV SCARAB_ENABLE_PT_MEMTRACE 1
ENV LD_LIBRARY_PATH $tmpdir/pin-3.15-98253-gb56e429b1-gcc-linux/extras/xed-intel64/lib
ENV LD_LIBRARY_PATH $tmpdir/pin-3.15-98253-gb56e429b1-gcc-linux/intel64/runtime/pincrt:$LD_LIBRARY_PATH
ENV LD_LIBRARY_PATH $DYNAMORIO_HOME/lib64/release:$LD_LIBRARY_PATH

# Build SimPoint 3.2
# Reference:
# https://github.com/intel/pinplay-tools/blob/main/pinplay-scripts/PinPointsHome/Linux/bin/Makefile
RUN cd $tmpdir/ && \
    git clone https://github.com/kofyou/SimPoint.3.2.git && \
    make -C SimPoint.3.2 && \
    ln -s SimPoint.3.2/bin/simpoint ./simpoint

RUN cd $tmpdir/ && git clone https://github.com/litz-lab/scarab
RUN pip3 install -r $tmpdir/scarab/bin/requirements.txt

# Install PMU tools
RUN cd $tmpdir && git clone https://github.com/andikleen/pmu-tools.git

ENV DOCKER_BUILDKIT 1
ENV COMPOSE_DOCKER_CLI_BUILD 1
